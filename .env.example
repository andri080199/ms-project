DATABASE_URL="postgresql://hrms:hrms@localhost:5433/hrms?schema=public"
# Generate dengan: openssl rand -base64 32
AUTH_SECRET="change-me-to-a-long-random-string"
NEXTAUTH_SECRET="change-me-to-a-long-random-string"
NEXTAUTH_URL="http://localhost:3000"
AUTH_TRUST_HOST="true"

# Mail provider — pilih salah satu: "smtp" atau "resend"
# Aktifin yg mau dipake; var provider yg gak aktif boleh dikosongin.
MAIL_PROVIDER="smtp"

# --- Provider 1: SMTP (Gmail) -------------------------------------------------
# Gmail SMTP — bikin App Password di https://myaccount.google.com/apppasswords
SMTP_USER="hrms@perusahaan.com"
SMTP_PASS="xxxxxxxxxxxxxxxx"
SMTP_FROM="FIERSA Notifikasi <fiersa@perusahaan.com>"

# --- Provider 2: Resend (HTTPS API) ------------------------------------------
# Signup di https://resend.com, generate API key di dashboard.
# `from` HARUS pake domain yg udah di-verify di Resend (SPF/DKIM).
# Buat dev/test sementara bisa pake "onboarding@resend.dev" (cuma bisa kirim ke email akun signup).
RESEND_API_KEY=""
RESEND_FROM="FIERSA Notifikasi <notif@domain-verified.com>"

APP_URL="http://localhost:3000"

## Passowrd Supabase
# E0rwXaMytcyrslw3

# Cron — token rahasia buat trigger endpoint /api/cron/*
# Generate: openssl rand -hex 32
# Trigger manual (test): curl "$APP_URL/api/cron/birthdays?token=$CRON_SECRET"
# Atau pakai scheduler harian (Vercel cron / GitHub Actions / EasyCron) — recommended
# jam 08:00 Asia/Jakarta (= 01:00 UTC). Cron expr: "0 1 * * *"
CRON_SECRET="7ad391c39b0bc22176ddaf0c1ef4666801f35c37ea981cec7640bd4090559eea"
